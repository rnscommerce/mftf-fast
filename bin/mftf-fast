#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * Drop-in replacement for vendor/bin/mftf that reuses a cached snapshot of
 * MFTF's parsed object handlers.
 *
 * MFTF re-parses the entire XML corpus on every invocation: references are flat
 * global names with no module qualifier, so each handler eagerly builds a
 * registry of every object before it can resolve any single one, and nothing is
 * cached between runs. Snapshotting those graphs takes single-test generation
 * from roughly 25s to 7s.
 *
 * Extra subcommands: cache:status, cache:clear, cache:warm, describe:test, describe:group
 */

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "mftf-fast must be run as a CLI application\n");
    exit(1);
}

// Two ways in. Installed with Composer this sits in vendor/bin and the
// project's autoloader carries everything; carried by another program it
// sits outside any project, so it loads its own three classes and then the
// project's autoloader once it knows where the project is.
$composer = null;
foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require_once $autoload;
        $composer = $autoload;
        break;
    }
}

if ($composer === null) {
    // No dependencies of its own - ReflectionClass, ReflectionProperty and
    // Throwable are the whole of it - so a four-line PSR-4 loader is enough.
    spl_autoload_register(static function (string $class): void {
        if (!str_starts_with($class, 'MftfFast\\')) {
            return;
        }
        $file = __DIR__ . '/../src/' . str_replace('\\', '/', substr($class, strlen('MftfFast\\'))) . '.php';
        if (is_file($file)) {
            require_once $file;
        }
    });
}

use MftfFast\HandlerCache;
use MftfFast\ProjectPaths;

try {
    $root = ProjectPaths::discover()->root();
} catch (\RuntimeException $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(1);
}

// Magento, MFTF and Symfony Console all come from the project under test, not
// from here. Loaded after discovery because discovery is what says where the
// project is; harmless when a composer autoloader already brought them.
$projectAutoload = $root . '/vendor/autoload.php';
if ($composer === null) {
    if (!is_file($projectAutoload)) {
        fwrite(STDERR, "No vendor/autoload.php in {$root}.\n");
        exit(1);
    }
    require_once $projectAutoload;
}

if (!class_exists(\Magento\FunctionalTestingFramework\Console\CommandList::class)) {
    fwrite(STDERR, "MFTF is not installed in {$root}.\n");
    exit(1);
}

$cache = new HandlerCache($root, HandlerCache::forceInArgv($argv));
$verbose = getenv('MFTF_FAST_QUIET') !== '1';
$sub = $argv[1] ?? '';

if ($sub === 'cache:clear') {
    printf("Removed %d snapshot(s) from %s/var/mftf-cache\n", $cache->clear(), $root);
    exit(0);
}

if ($sub === 'cache:status') {
    printf("%-14s %-8s %-8s %s\n", 'HANDLER', 'CACHED', 'VALID', 'SIZE');
    foreach ($cache->status() as $type => $s) {
        printf(
            "%-14s %-8s %-8s %s\n",
            $type,
            $s['exists'] ? 'yes' : 'no',
            $s['valid'] ? 'yes' : 'STALE',
            $s['bytes'] ? sprintf('%.1fMB', $s['bytes'] / 1048576) : '-'
        );
    }
    exit(0);
}

if ($sub === 'cache:warm') {
    // cache:warm [--force] [type ...]: only what is named, and of that only what is not already good.
    $types = array_values(array_filter(array_slice($argv, 2), static fn ($arg) => $arg !== '' && $arg[0] !== '-'));
    $unknown = array_diff($types, HandlerCache::types());
    if ($unknown !== []) {
        fwrite(STDERR, sprintf("  no snapshot is kept for: %s\n  kept: %s\n", implode(', ', $unknown), implode(', ', HandlerCache::types())));
        exit(1);
    }
    $restored = $cache->restore(true);
    $cfg = \Magento\FunctionalTestingFramework\Config\MftfApplicationConfig::class;
    $cfg::create(HandlerCache::forceInArgv($argv), $cfg::GENERATION_PHASE, false, $cfg::LEVEL_DEFAULT, true);
    $patch = $cache->patch();
    if ($patch !== null) {
        if ($cache->validatePatch()) {
            $cache->settleOrder();
            printf("  patched %d name(s) from %d changed file(s)\n", $patch['names'], $patch['changed']);
        } else {
            $cache->dropPatched();
        }
    }
    $cache->unpackAll();
    foreach ($cache->warm($types, $restored) as $type => $secs) {
        printf("  built %-14s %6.2fs\n", $type, $secs);
    }
    printf("  snapshotted: %s\n", implode(', ', $cache->persist($restored)) ?: 'nothing');
    exit(0);
}

if ($sub === 'describe:test' || $sub === 'describe:group') {
    // describe:test|describe:group [--force] <name>: the test or action group as MFTF holds it merged, as JSON.
    $names = array_values(array_filter(array_slice($argv, 2), static fn ($arg) => $arg !== '' && $arg[0] !== '-'));
    if (count($names) !== 1) {
        fwrite(STDERR, $sub === 'describe:test'
            ? "usage: mftf-fast describe:test [--force] <test name>\n"
            : "usage: mftf-fast describe:group [--force] <action group name>\n");
        exit(1);
    }
    // Describing reads no suite.
    $restored = $cache->restore(true, ['suite']);
    $cfg = \Magento\FunctionalTestingFramework\Config\MftfApplicationConfig::class;
    $cfg::create(HandlerCache::forceInArgv($argv), $cfg::GENERATION_PHASE, false, $cfg::LEVEL_DEFAULT, true);
    // MFTF prints its deprecations to stdout as it parses; only the JSON goes there.
    ob_start();
    $tp = microtime(true);
    $patch = $cache->patch();
    // A patched snapshot is checked against the schema and saved by a child of
    // its own, before describing resolves anything in it, while this answers.
    $pid = $patch !== null ? pcntl_fork() : -1;
    if ($pid === 0) {
        ob_end_clean();
        posix_setsid();
        // The caller waits for these to close; MFTF still prints, and PHP ends a script whose print fails.
        fclose(STDOUT);
        $out = fopen('/dev/null', 'w');
        fclose(STDERR);
        $err = fopen('/dev/null', 'w');
        $cache->forgetPatched();
        if ($cache->validatePatch()) {
            $cache->settleOrder();
            $cache->persist($restored);
        }
        exit(0);
    }
    if ($patch !== null && $pid < 0 && !$cache->validatePatch()) {
        $cache->dropPatched();
        $patch = null;
    }
    if ($patch !== null) {
        fwrite(STDERR, sprintf("[mftf-fast] patched %d name(s) from %d changed file(s) in %.2fs\n", $patch['names'], $patch['changed'], microtime(true) - $tp));
    }
    try {
        if ($sub === 'describe:test') {
            $cache->unpackTest($names[0]);
        }
        $described = $sub === 'describe:test' ? MftfFast\Describe::test($names[0]) : MftfFast\Describe::actionGroup($names[0]);
    } catch (\Throwable $e) {
        // What MFTF printed before it gave up names the fault; the exception only summarises it.
        fwrite(STDERR, ob_get_clean());
        fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
        exit(1);
    }
    ob_end_clean();
    echo json_encode($described, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE), "\n";
    if ($pid > 0) {
        exit(0);
    }
    $saved = $cache->persist($restored);
    if ($verbose && ($restored !== [] || $saved !== [])) {
        fwrite(STDERR, sprintf("[mftf-fast] restored %s; snapshotted %s\n", implode('+', $restored) ?: 'nothing', implode('+', $saved) ?: 'nothing'));
    }
    exit(0);
}

$t0 = microtime(true);
$restored = $cache->restore();
$restoreTime = microtime(true) - $t0;

// The framework that answered class_exists above: where its bootstrap put
// FW_BP, which is vendor's copy unless something carried its own in first.
$versionFile = (defined('FW_BP') ? FW_BP : $root . '/vendor/magento/magento2-functional-testing-framework') . '/composer.json';
$version = is_file($versionFile)
    ? (string) (json_decode((string) file_get_contents($versionFile), true)['version'] ?? 'unknown')
    : 'unknown';

$output = null;
try {
    // Generation that ran to its end says so, with or without "(with errors)"
    // after it, and nothing else does: MFTF returns the same 1 for a project whose
    // tests share a test case id as for a parser that threw half way.
    $output = new class extends Symfony\Component\Console\Output\ConsoleOutput {
        public bool $generationFinished = false;

        protected function doWrite($message, $newline): void
        {
            if (str_contains((string) $message, 'Generate Tests Command Run')) {
                $this->generationFinished = true;
            }
            parent::doWrite($message, $newline);
        }
    };

    $application = new Symfony\Component\Console\Application();
    $application->setName('MFTF CLI (cached handlers)');
    $application->setVersion($version);
    foreach ((new \Magento\FunctionalTestingFramework\Console\CommandList())->getCommands() as $command) {
        $application->add($command);
    }
    $application->setAutoExit(false);
    $code = $application->run(null, $output);
} catch (\Throwable $e) {
    fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
    $code = 1;
}

// A handler that threw mid-parse is left as a live singleton holding a partial
// registry, so only a run that finished has anything worth snapshotting. One
// that finished with errors parsed everything a clean one would have.
$t = microtime(true);
$saved = $code === 0 || $output?->generationFinished ? $cache->persist($restored) : [];

if ($verbose) {
    // A type refused here is one that will be re-parsed on every future run,
    // and the reason is worth knowing.
    foreach ($cache->incomplete() as $type => $missing) {
        fwrite(STDERR, sprintf(
            "[mftf-fast] not caching %s: the corpus declares %d it never loaded (%s%s).\n"
            . "            Generation ran without --force, or a module is disabled on the instance.\n",
            $type,
            count($missing),
            implode(', ', array_slice($missing, 0, 3)),
            count($missing) > 3 ? ', …' : ''
        ));
    }

    $parts = [];
    if ($restored !== []) {
        $parts[] = sprintf('restored %s in %.2fs', implode('+', $restored), $restoreTime);
    }
    if ($saved !== []) {
        $parts[] = sprintf('snapshotted %s in %.2fs', implode('+', $saved), microtime(true) - $t);
    }
    if ($parts !== []) {
        fwrite(STDERR, '[mftf-fast] ' . implode('; ', $parts) . "\n");
    }
}
exit($code);
