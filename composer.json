{
    "name": "rnscommerce/mftf-fast",
    "description": "A drop-in for vendor/bin/mftf that snapshots MFTF's parsed object handlers, so a single test generates in seconds rather than half a minute.",
    "type": "library",
    "license": "MIT",
    "keywords": ["magento", "mftf", "testing"],
    "homepage": "https://github.com/rnscommerce/mftf-fast",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/console": "^6.4 || ^7.0"
    },
    "conflict": {
        "magento/magento2-functional-testing-framework": "<4.0"
    },
    "suggest": {
        "magento/magento2-functional-testing-framework": "^4.0 || ^5.0 || ^6.0, the framework this snapshots"
    },
    "autoload": {
        "psr-4": {
            "MftfFast\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MftfFast\\Tests\\": "tests/"
        },
        "files": [
            "tests/Fixtures/FakeHandlers.php"
        ]
    },
    "bin": ["bin/mftf-fast"]
}
